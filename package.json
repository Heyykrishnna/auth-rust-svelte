{
  "name": "secure-auth-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.override.yml up",
    "dev:web": "npm -w @secure-auth/web run dev",
    "dev:api": "cd apps/auth-api && cargo watch -x run",
    "build": "npm -w @secure-auth/shared-types run check && npm -w @secure-auth/web run build",
    "check": "npm -w @secure-auth/shared-types run check && npm -w @secure-auth/web run check",
    "test": "npm -w @secure-auth/web run test",
    "lint": "npm -w @secure-auth/web run lint"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "overrides": {
    "eslint": "^10.9.1"
  }
}
