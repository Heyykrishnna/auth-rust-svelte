  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "API & AUTHENTICATION HEALTH",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "title": "Total Request Rate (req/s)",
      "type": "stat",
      "targets": [
        { "expr": "sum(rate(http_plane_requests_total[5m]))", "legendFormat": "req/s", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "title": "5xx Error Rate (%)",
      "type": "stat",
      "targets": [
        { "expr": "100 * sum(rate(http_plane_requests_total{status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(http_plane_requests_total[5m])), 0.001)", "legendFormat": "5xx %", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "title": "Sign-In Success vs Failure (5m)",
      "type": "stat",
      "targets": [
        { "expr": "sum(increase(auth_sign_in_total{outcome=\"success\"}[5m]))", "legendFormat": "Success", "refId": "A" },
        { "expr": "sum(increase(auth_sign_in_total{outcome=\"failure\"}[5m]))", "legendFormat": "Failure", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "title": "Brute-Force Lockouts (15m)",
      "type": "stat",
      "targets": [
        { "expr": "increase(auth_lockout_total[15m])", "legendFormat": "Lockouts", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "title": "Request Rate by Architectural Plane",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (plane) (rate(http_plane_requests_total[5m]))", "legendFormat": "{{plane}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "title": "p50 / p95 / p99 Request Latency (s)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_plane_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_plane_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_plane_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 8,
      "title": "4xx / 5xx Error Budgets by Plane",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (plane, status_class) (rate(http_plane_requests_total{status_class=~\"4xx|5xx\"}[5m]))", "legendFormat": "{{plane}} {{status_class}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 9,
      "title": "Argon2id Hashing Duration p95 (s)",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(argon2_hash_duration_seconds_bucket[5m])) by (le))", "legendFormat": "Argon2id p95", "refId": "A" }
      ]
    }
  ],
