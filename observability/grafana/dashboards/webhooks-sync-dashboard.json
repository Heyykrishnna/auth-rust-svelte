      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 6,
      "title": "Webhook Delivery Rate by Status Class",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (status_class) (rate(webhook_delivery_total[5m]))", "legendFormat": "{{status_class}}", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 7,
      "title": "Webhook Delivery Latency p50 / p95 (s)",
      "type": "timeseries",
      "targets": [
