      "type": "stat",
      "targets": [
        { "expr": "increase(webhook_dead_letter_total[1h])", "legendFormat": "DLQ", "refId": "A" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
