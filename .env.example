DATABASE_URL=postgres://authuser:authpassword@localhost:5432/authdb
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRY_SECS=900     
JWT_REFRESH_EXPIRY_SECS=604800   

AUTH_API_PORT=8080
AUTH_API_HOST=0.0.0.0
RUST_LOG=auth_api=debug,tower_http=info

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oidc/google/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/auth/oidc/github/callback

PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_APP_NAME=AuthApp

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=auth-api
OTEL_SERVICE_VERSION=0.1.0

POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpassword
POSTGRES_DB=authdb
