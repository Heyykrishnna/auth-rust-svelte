# ==============================================================================
# Database (PostgreSQL)
# ==============================================================================
POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpassword
POSTGRES_DB=authdb
POSTGRES_PORT=5432
DATABASE_URL=postgres://authuser:authpassword@localhost:5432/authdb
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

# ==============================================================================
# In-Memory Cache & Session Store (Redis)
# ==============================================================================
REDIS_PASSWORD=devredispassword
REDIS_URL=redis://:devredispassword@localhost:6379

# ==============================================================================
# Cryptography & Security Secrets
# Generate production secret with: openssl rand -base64 48
# Must be at least 32 characters long
# ==============================================================================
JWT_SECRET=dev_jwt_secret_change_me_in_production_min_32_chars
JWT_ACCESS_EXPIRY_SECS=900
JWT_REFRESH_EXPIRY_SECS=604800

# ==============================================================================
# Backend Server Configuration (Axum)
# ==============================================================================
AUTH_API_HOST=0.0.0.0
AUTH_API_PORT=8080
RUST_LOG=auth_api=debug,tower_http=info,sqlx=warn

# ==============================================================================
# Security & Cookie Policies
# Set COOKIE_SECURE=true in production (HTTPS)
# Set COOKIE_DOMAIN=.example.com for multi-subdomain cookie sharing
# ==============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ==============================================================================
# Authentication & Rate Limiting Thresholds
# ==============================================================================
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECS=900
VERIFICATION_CODE_EXPIRY_SECS=900
PASSWORD_RESET_EXPIRY_SECS=900

# ==============================================================================
# Frontend Server Configuration (SvelteKit)
# ==============================================================================
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_APP_NAME=SecureAuthPlatform
ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000

# ==============================================================================
# OIDC / Social Authentication
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback?provider=github

# ==============================================================================
# Observability & OpenTelemetry
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=auth-api
OTEL_SERVICE_VERSION=1.0.0

# ==============================================================================
# Observability Dashboard (Grafana)
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GF_AUTH_ANONYMOUS_ENABLED=false

# ==============================================================================
# Email & SMTP Delivery
# Leave SMTP_HOST empty in local dev to log email delivery requests safely
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SecureAuth <no-reply@authplatform.local>
SMTP_FROM_NAME=SecureAuth
