POSTGRES_USER=authuser
POSTGRES_PASSWORD=authpassword
POSTGRES_DB=authdb
POSTGRES_PORT=5432

DATABASE_URL=postgres://authuser:authpassword@localhost:5432/authdb
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-cryptographically-secure-random-secret-min-32-chars
JWT_ACCESS_EXPIRY_SECS=900
JWT_REFRESH_EXPIRY_SECS=604800

AUTH_API_HOST=0.0.0.0
AUTH_API_PORT=8080
RUST_LOG=auth_api=debug,tower_http=info,sqlx=warn

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_SECS=900
VERIFICATION_CODE_EXPIRY_SECS=900
PASSWORD_RESET_EXPIRY_SECS=900

PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_APP_NAME=SecureAuthPlatform
ORIGIN=http://localhost:3000
HOST=0.0.0.0
PORT=3000

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback?provider=github

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=auth-api
OTEL_SERVICE_VERSION=1.0.0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
SMTP_USERNAME=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Dradix <support@dradix.dev>
SMTP_FROM_NAME=Dradix
SMTP_FROM_EMAIL=support@dradix.dev
SENDER_EMAIL=support@dradix.dev

